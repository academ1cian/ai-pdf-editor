{
  "name": "ai-pdf-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm fixtures && node scripts/build-metadata.mjs && pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest run",
    "fixtures": "node scripts/fixtures.mjs",
    "poc": "tsx scripts/prove-engine.ts",
    "test:e2e": "playwright test",
    "licenses": "node scripts/licenses.mjs",
    "format": "prettier --write src worker functions scripts tests *.ts *.json *.mjs .github/workflows"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "lucide-react": "1.56.0",
    "mupdf": "1.28.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "5.20261013.1",
    "@eslint/js": "10.0.1",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  }
}
