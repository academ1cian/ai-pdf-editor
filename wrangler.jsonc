{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-pdf-editor-proxy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "vars": { "ENABLE_AI": "false", "GROQ_MODEL": "openai/gpt-oss-120b", "ALLOWED_ORIGIN": "https://ai-pdf-editor.pages.dev", "TURNSTILE_SITE_KEY": "" },
  "ai":{"binding":"AI"},
  "durable_objects": { "bindings": [{"name":"BUDGET", "class_name":"AIBudget"}] },
  "migrations": [{"tag":"v1", "new_sqlite_classes":["AIBudget"]}],
  "observability": {"enabled":false}
}
